{
 "name": "dyllu-catalog",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "node scripts/prestart.mjs && next build",
  "start": "node scripts/prestart.mjs && next start",
  "db:push": "prisma db push",
  "db:seed": "tsx prisma/seed.ts",
  "studio": "prisma studio",
  "postinstall": "prisma generate",
  "typecheck": "tsc --noEmit",
  "check": "node scripts/check-env.mjs",
  "db:validate": "prisma validate",
  "setup": "npm run check && prisma generate && prisma db push && tsx prisma/seed.ts",
  "start:only": "next start",
  "build:only": "next build",
  "catalog:import": "node scripts/import-catalog.mjs",
  "english:backfill": "node scripts/backfill-english.mjs"
 },
 "dependencies": {
  "@anthropic-ai/sdk": "^0.131.0",
  "@aws-sdk/client-s3": "^3.600.0",
  "@prisma/client": "^5.20.0",
  "next": "^14.2.0",
  "prisma": "^5.20.0",
  "qrcode": "^1.5.4",
  "react": "^18.3.0",
  "react-dom": "^18.3.0",
  "sharp": "^0.33.5",
  "zod": "^3.23.0",
  "zustand": "^4.5.0"
 },
 "devDependencies": {
  "@types/node": "^20",
  "@types/qrcode": "^1.5.5",
  "@types/react": "^18",
  "@types/react-dom": "^18.3.7",
  "autoprefixer": "^10",
  "postcss": "^8",
  "tailwindcss": "^3.4.0",
  "tsx": "^4.19.0",
  "typescript": "^5.5.0"
 },
 "engines": {
  "node": ">=18.17"
 }
}
