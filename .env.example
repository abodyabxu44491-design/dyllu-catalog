# DYLLU Catalog — environment variables
# Copyright (c) 2026 Abdullah Al-Sakni. All rights reserved.
# Copy to .env (cp .env.example .env) and fill in the values. Never commit .env.

# ===== Required =====
# PostgreSQL connection string (local or hosted: Neon, Supabase, Railway...)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Secret used to sign admin/rep sessions and the wholesale cookie (32+ random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a key derived from DATABASE_URL is used.
ADMIN_SESSION_SECRET=

# Optional fallback for absolute links (QR codes, invoices, sharing use the request domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: official domain. Old *.onrender.com / production *.vercel.app links redirect here.
MAIN_DOMAIN=dyllusa.com

# ===== Admin account =====
# Created on build/start (scripts/prestart.mjs). Password: 8+ characters.
# Changing ADMIN_PASSWORD and redeploying updates the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Optional: image storage on S3 / Cloudflare R2 =====
# If S3_BUCKET is empty, images are stored in the database (works on Vercel/Render with no setup).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY=
S3_SECRET=
# Public bucket URL without a trailing slash, e.g. https://pub-xxxx.r2.dev
S3_PUBLIC_URL=

# ===== Optional: higher-quality translation =====
# Arabic -> English translation works without a key. With a Claude API key, Claude is used instead.
ANTHROPIC_API_KEY=
