# انسخ هذا الملف إلى .env (cp .env.example .env) واملأ القيم. لا ترفع ملف .env إلى أي مكان.

# ===== مطلوب =====
# رابط قاعدة بيانات PostgreSQL (محلية أو سحابية مثل Neon / Supabase / Railway)
# الشكل: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# مفتاح توقيع جلسات الأدمن وكوكي الجملة: نص عشوائي طويل (32 حرفًا على الأقل)
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# اختياري: روابط QR والفواتير والمشاركة تؤخذ تلقائيًا من الدومين الذي فُتح عليه الموقع. هذا احتياطي فقط.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== حساب الأدمن =====
# يُنشأ تلقائيًا عند تشغيل الموقع (npm start) أو بالأمر npm run db:seed. كلمة المرور 8 أحرف على الأقل.
# تغيير ADMIN_PASSWORD ثم إعادة التشغيل يحدّث كلمة المرور (مفيد إن نسيتها).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== اختياري: تخزين الصور على S3 / Cloudflare R2 =====
# إن تُرك S3_BUCKET فارغًا تُحفظ الصور في قاعدة البيانات نفسها (تعمل على Render و Vercel بدون إعداد إضافي).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY=
S3_SECRET=
# الرابط العام للـ bucket بدون / في النهاية، مثال: https://pub-xxxx.r2.dev
S3_PUBLIC_URL=

# ===== اختياري: ترجمة بجودة أعلى =====
# الترجمة للإنجليزية تعمل تلقائيًا بدون أي مفتاح. إن أضفت مفتاح Claude API (https://platform.claude.com) تُستخدم Claude بدلًا منها.
ANTHROPIC_API_KEY=
