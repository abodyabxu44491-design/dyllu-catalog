# انسخ هذا الملف إلى .env (cp .env.example .env) واملأ القيم. لا ترفع ملف .env إلى أي مكان.

# ===== مطلوب =====
# رابط قاعدة بيانات PostgreSQL (محلية أو سحابية مثل Neon / Supabase / Railway)
# الشكل: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# مفتاح توقيع جلسات الأدمن وكوكي الجملة: نص عشوائي طويل (32 حرفًا على الأقل)
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# رابط موقعك النهائي (يُستخدم في رموز QR وعناوين المشاركة). محليًا: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== حساب الأدمن (يُستخدم مرة واحدة عند npm run db:seed) =====
# بعد إنشاء الحساب احذف ADMIN_PASSWORD من الملف. كلمة المرور 8 أحرف على الأقل.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== اختياري: تخزين الصور على S3 / Cloudflare R2 =====
# إن تُرك S3_BUCKET فارغًا تُحفظ الصور محليًا في public/uploads (يعمل على سيرفرك الخاص فقط، لا يعمل على Vercel).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY=
S3_SECRET=
# الرابط العام للـ bucket بدون / في النهاية، مثال: https://pub-xxxx.r2.dev
S3_PUBLIC_URL=

# ===== اختياري: الترجمة التلقائية (عربي ⇄ إنجليزي) =====
# مفتاح Claude API من https://platform.claude.com — عند ضبطه تُترجم الحقول الفارغة تلقائيًا عند حفظ المنتجات
# والتصنيفات والإعلانات والإعدادات، ويظهر زر «ترجمة تلقائية» في نموذج المنتج. بدونه تبقى الإنجليزية اختيارية.
ANTHROPIC_API_KEY=
